# Настройки обмена таблицами с Supabase: выгрузка в app/db (python app/tools/supabase_pull.py)
# и отправка правок обратно (python app/tools/supabase_push.py — нужен secret-ключ).
# Скопируй этот файл в .env.local и заполни. .env.local не должен попадать в git.

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://<project-ref>.supabase.co/rest/v1/

# Supabase → Project Settings → API Keys → Secret key (sb_secret_...)
# Подойдёт и legacy service_role. Publishable/anon-ключ тоже работает,
# но только при политике RLS на чтение.
SUPABASE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Сервер и постоянные данные (Northflank задаёт эти переменные в Runtime variables).
HOST=0.0.0.0
PORT=8080
APP_DATA_DIR=/data
# Полный HTTPS origin без завершающего слеша. При отсутствии сервер сверяет Origin с Host.
PUBLIC_ORIGIN=
# Ключи нейросетей: только Runtime variables/Secrets, никогда в репозитории или образе.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
